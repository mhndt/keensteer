#!/bin/sh

ENABLED=yes
DESC="keensteer"
root=${KEENSTEER_ROOT:-}
PATH=$root/opt/sbin:/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin

configs()
{
	ls "$root/opt/etc/keensteer.conf" "$root"/opt/etc/keensteer-*.conf 2>/dev/null
}

running()
{
	for pid in $(pidof keensteerd); do
		tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq -- " -c $1 " && return 0
	done
	return 1
}

start()
{
	[ "$ENABLED" = yes ] || return 8
	for c in $(configs); do
		running "$c" && continue
		keensteerd -c "$c" >/dev/null 2>&1 &
	done
	sleep 1
	for c in $(configs); do
		running "$c" || { echo "$DESC: failed to start $c" >&2; return 255; }
	done
	echo "$DESC: started"
}

stop()
{
	killall keensteerd 2>/dev/null
	n=0
	while [ -n "$(pidof keensteerd)" ] && [ "$n" -lt 10 ]; do sleep 1; n=$((n + 1)); done
	[ -z "$(pidof keensteerd)" ] || { echo "$DESC: failed to stop" >&2; return 255; }
	echo "$DESC: stopped"
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop && start ;;
	kill) killall -9 keensteerd 2>/dev/null ;;
	check) for c in $(configs); do running "$c" && echo "$c: alive" || echo "$c: dead"; done ;;
	*) echo "usage: $0 {start|stop|restart|check|kill}" >&2; exit 1 ;;
esac
